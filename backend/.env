# Email Configuration (for notifications)
# Gmail App Password (recommended for personal Gmail or Google Workspace):
# 1) Enable 2-Step Verification on your Google account
# 2) Create an App Password (16 characters, no spaces)
# 3) Use your Gmail/Workspace email as EMAIL_USER and the app password as EMAIL_PASS
# 4) Either:
#    - Keep SMTP_HOST/PORT to send via Gmail SMTP (host smtp.gmail.com, port 587, TLS)
#    - Or comment out SMTP_HOST to let Nodemailer use the built-in 'gmail' service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password
# If left blank, the code will default to EMAIL_USER as the From address
